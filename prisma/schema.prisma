generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                       @id @default(autoincrement())
  username            String                    @unique
  passwordHash        String
  name                String
  createdAt           DateTime                  @default(now())
  auditLogs           AuditLog[]
  failuresResolved    FailureLog[]
  discrepancyLogs     DiscrepancyLog[]
  stocktakesStarted   Stocktake[]               @relation("StocktakeStartedBy")
  stocktakesCompleted Stocktake[]               @relation("StocktakeCompletedBy")
  stocktakeScans      StocktakeScan[]
  stocktakeUnknowns   StocktakeUnknownBarcode[]
  stocktakeExclusions StocktakeItem[]           @relation("StocktakeItemExcludedBy")
}

model Supplier {
  id          Int       @id @default(autoincrement())
  name        String
  contactName String?
  email       String?
  phone       String?
  createdAt   DateTime  @default(now())
  vendors     Vendor[]
  invoices    Invoice[]
  credits     Credit[]
}

model Vendor {
  id                Int               @id @default(autoincrement())
  name              String
  contactName       String?
  email             String?
  phone             String?
  address           String?
  city              String?
  state             String?
  zip               String?
  website           String?
  shopifyVendorName String?
  supplierId        Int?
  supplier          Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  invoices          Invoice[]
  credits           Credit[]
  auditLogs         AuditLog[]
  vendorProfile     VendorProfile?
  lineItems         InvoiceLineItem[]
  discrepancyLogs   DiscrepancyLog[]
}

model VendorProfile {
  id              String   @id @default(cuid())
  vendorId        Int      @unique
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  columnMappings  Json
  extractionHints Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Invoice {
  id                Int               @id @default(autoincrement())
  invoiceNumber     String
  vendor            Vendor?           @relation(fields: [vendorId], references: [id])
  vendorId          Int?
  supplier          Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId        Int?
  status            InvoiceStatus     @default(ORDERED)
  invoiceDate       DateTime?
  paymentTerms      String?
  paymentTermsNotes String?
  dueDate           DateTime?
  total             Decimal           @db.Decimal(10, 2)
  shippingCost      Decimal?          @db.Decimal(10, 2)
  adjustments       Decimal?          @db.Decimal(10, 2)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lineItems         InvoiceLineItem[]
  discrepancyLogs   DiscrepancyLog[]

  shopifySyncStatus    ShopifySyncStatus?
  shopifySyncStartedAt DateTime?
  shopifySyncEndedAt   DateTime?
  shopifySyncError     String?
}

enum InvoiceStatus {
  ORDERED
  DRAFT_RECEIVING
  RECEIVED
  PAID
}

enum ShopifySyncStatus {
  SYNCING
  SYNCED
  FAILED
}

model InvoiceLineItem {
  id                     Int              @id @default(autoincrement())
  invoice                Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId              Int
  vendorId               Int?
  vendor                 Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  sku                    String?
  description            String
  quantityOrdered        Int
  quantityReceived       Int              @default(0)
  unitCost               Decimal          @db.Decimal(10, 2)
  retailPrice            Decimal?         @db.Decimal(10, 2)
  hasDiscrepancy         Boolean          @default(false)
  receivingNote          String?
  barcode                String?
  shopifyProductTitle    String?
  shopifyVariantId       String?
  shopifyInventoryItemId String?
  skipped                Boolean          @default(false)
  inventorySynced        Boolean          @default(false)
  discrepancyLogs        DiscrepancyLog[]
}

model Credit {
  id            Int              @id @default(autoincrement())
  vendor        Vendor           @relation(fields: [vendorId], references: [id])
  vendorId      Int
  supplier      Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId    Int?
  amount        Decimal          @db.Decimal(10, 2)
  sku           String?
  description   String?
  quantity      Int?
  invoiceNumber String?
  notes         String?
  date          DateTime         @default(now())
  adjustments   Decimal?         @db.Decimal(10, 2)
  lineItems     CreditLineItem[]
}

model CreditLineItem {
  id                     Int     @id @default(autoincrement())
  credit                 Credit  @relation(fields: [creditId], references: [id], onDelete: Cascade)
  creditId               Int
  sku                    String?
  description            String
  quantity               Int
  unitCost               Decimal @db.Decimal(10, 2)
  lineTotal              Decimal @db.Decimal(10, 2)
  shopifyVariantId       String?
  shopifyInventoryItemId String?
  shopifyProductTitle    String?
  barcode                String?
  inventorySynced        Boolean @default(false)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  action    String
  details   String?
  timestamp DateTime @default(now())
  vendorId  Int?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
}

model FailureLog {
  id           Int       @id @default(autoincrement())
  operation    String
  itemLabel    String
  errorMessage String
  occurredAt   DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById Int?
  resolvedBy   User?     @relation(fields: [resolvedById], references: [id])
}

model DiscrepancyLog {
  id                Int             @id @default(autoincrement())
  invoiceLineItemId Int
  invoiceLineItem   InvoiceLineItem @relation(fields: [invoiceLineItemId], references: [id], onDelete: Cascade)
  invoiceId         Int
  invoice           Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  vendorId          Int?
  vendor            Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  sku               String?
  expectedQty       Int
  actualQty         Int
  note              String?
  staffId           Int
  staff             User            @relation(fields: [staffId], references: [id])
  createdAt         DateTime        @default(now())
}

model AppSetting {
  key   String @id
  value String
}

enum SyncStatus {
  RUNNING
  COMPLETE
  ERROR
}

model ProductCache {
  id               String   @id @default(cuid())
  variantId        String   @unique
  productId        String
  inventoryItemId  String?
  title            String
  variantTitle     String
  sku              String?
  barcode          String?
  vendor           String?
  productType      String?
  tags             String[]
  price            Decimal  @db.Decimal(10, 2)
  cost             Decimal? @db.Decimal(10, 2)
  currentInventory Int
  tracked          Boolean  @default(true)
  imageUrl         String?
  status           String   @default("ACTIVE")
  syncedAt         DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SalesCache {
  id        String   @id @default(cuid())
  variantId String
  sku       String?
  date      DateTime
  unitsSold Int
  revenue   Decimal  @db.Decimal(10, 2)

  @@unique([variantId, date])
}

model SyncLog {
  id              String     @id @default(cuid())
  status          SyncStatus
  syncType        String     @default("FULL")
  startedAt       DateTime   @default(now())
  completedAt     DateTime?
  durationMs      Int?
  variantsSynced  Int?
  salesDaysSynced Int?
  totalVariants   Int?
  currentVariant  Int?
  errorMessage    String?
}

// ─── Stocktake ────────────────────────────────────────────────────────────────

enum StocktakeMode {
  SCOPED
  FREE_SCAN
}

enum StocktakeStatus {
  PREPARING
  IN_PROGRESS
  REVIEW
  APPLYING
  COMPLETED
  CANCELLED
}

enum StocktakeDriftResolution {
  KEEP_COUNT
  ADJUST_FOR_MOVEMENT
  SKIP
}

enum StocktakeScanKind {
  SCAN
  MANUAL_SET
  LINKED
}

model Stocktake {
  id            Int             @id @default(autoincrement())
  name          String
  mode          StocktakeMode
  filters       Json?
  status        StocktakeStatus @default(PREPARING)
  locationId    String
  zeroUnscanned Boolean         @default(false)
  notes         String?
  startedById   Int
  startedBy     User            @relation("StocktakeStartedBy", fields: [startedById], references: [id])
  startedAt     DateTime        @default(now())
  completedById Int?
  completedBy   User?           @relation("StocktakeCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?

  // Live snapshot progress (PREPARING)
  snapshotTotal Int?
  snapshotDone  Int?

  // Background apply progress (APPLYING)
  applyTotal       Int?
  applyDone        Int?
  applyStartedAt   DateTime?
  applyEndedAt     DateTime?
  applyError       String?
  applyAttempt     Int       @default(0)
  // Reason Shopify accepted ("cycle_count_available", or "correction" fallback)
  applyReason      String?
  // Updated on every step of a running apply; stale for 5 minutes => Resume
  applyHeartbeatAt DateTime?
  // "PASSED" once the single test item succeeded, or "SKIPPED" by explicit choice
  applyTestResult  String?

  items           StocktakeItem[]
  scans           StocktakeScan[]
  unknownBarcodes StocktakeUnknownBarcode[]

  @@index([status])
  @@index([startedAt])
}

// All quantities (expectedQty, liveQtyAtReview, targetQty) are Shopify "on_hand"
// values so they compare like-for-like with changeFromQuantity on apply.
model StocktakeItem {
  id                    Int                       @id @default(autoincrement())
  stocktakeId           Int
  stocktake             Stocktake                 @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  variantId             String
  productId             String?
  inventoryItemId       String
  sku                   String?
  barcode               String?
  title                 String
  variantTitle          String
  vendor                String?
  expectedQty           Int
  countedQty            Int?
  cost                  Decimal?                  @db.Decimal(10, 2)
  outsideScope          Boolean                   @default(false)
  liveQtyAtReview       Int?
  liveAvailableAtReview Int?
  drifted               Boolean                   @default(false)
  driftResolution       StocktakeDriftResolution?
  targetQty             Int?
  applied               Boolean                   @default(false)
  appliedAt             DateTime?
  applyError            String?
  // Shopify returned CHANGE_FROM_QUANTITY_STALE: re-run the drift check before retrying
  applyStale            Boolean                   @default(false)
  // "Exclude from apply" for items flagged tracking off / gone from Shopify
  excludedAt            DateTime?
  excludedById          Int?
  excludedBy            User?                     @relation("StocktakeItemExcludedBy", fields: [excludedById], references: [id], onDelete: SetNull)
  excludeReason         String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  scans                 StocktakeScan[]
  linkedUnknowns        StocktakeUnknownBarcode[]

  @@unique([stocktakeId, variantId])
  @@index([stocktakeId, barcode])
  @@index([stocktakeId, sku])
  @@index([stocktakeId, applied])
}

model StocktakeScan {
  id          Int               @id @default(autoincrement())
  stocktakeId Int
  stocktake   Stocktake         @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  itemId      Int
  item        StocktakeItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind        StocktakeScanKind @default(SCAN)
  barcode     String?
  qtyBefore   Int?
  qtyAfter    Int
  scannedById Int
  scannedBy   User              @relation(fields: [scannedById], references: [id])
  scannedAt   DateTime          @default(now())
  undoneAt    DateTime?

  @@index([stocktakeId, scannedById, scannedAt])
  @@index([itemId])
}

model StocktakeUnknownBarcode {
  id              Int            @id @default(autoincrement())
  stocktakeId     Int
  stocktake       Stocktake      @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  barcode         String
  scanCount       Int            @default(1)
  lastScannedById Int?
  lastScannedBy   User?          @relation(fields: [lastScannedById], references: [id], onDelete: SetNull)
  lastScannedAt   DateTime       @default(now())
  resolvedItemId  Int?
  resolvedItem    StocktakeItem? @relation(fields: [resolvedItemId], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?

  @@unique([stocktakeId, barcode])
}
